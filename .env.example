# Copy this file to .env and change the values.

# Your own phone number (10 digits). When you log in with it you become the top admin.
SUPERADMIN_PHONE=9840063880

# 1 = show the login code on screen and load sample departments (for testing).
# 0 = real use (you must send the code by SMS or WhatsApp yourself).
DEV_MODE=1

# SQLite file for now. Later, a Postgres address works here too.
DATABASE_URL=sqlite:///sewa.db

COUNTRY_CODE=91

# Fill these only after you set up the WhatsApp Business Cloud API (see README).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
